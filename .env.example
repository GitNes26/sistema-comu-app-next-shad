# Base de datos (MySQL)
DATABASE_URL="mysql://root@localhost:3306/db_comu_app"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# Superadmin de plataforma (el seeder lo crea si ambos existen)
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""

# Correo (opcional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Web push (opcional)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Remitente de las notificaciones push (mailto: o https://). Genera las llaves con: npm run vapid:generate
VAPID_SUBJECT=""

# Envío programado de reportes por correo (requiere SMTP_*).
# El planificador interno revisa cada 5 min; REPORT_SCHEDULER="off" lo apaga.
# CRON_SECRET habilita POST /api/cron/reports (Authorization: Bearer <secreto>) para un cron externo.
REPORT_SCHEDULER=""
CRON_SECRET=""

# Pagos en línea: llave con la que se cifran las credenciales de la pasarela de cada iglesia.
# Si se deja vacía se deriva de NEXTAUTH_SECRET. Cámbiala solo antes de guardar credenciales.
PAYMENTS_SECRET_KEY=""

# Semilla de demostración: solo desarrollo (NODE_ENV != production)
SEED_DEMO="false"
# "true" = tras un cambio importante en la BD, borra y recrea la base al arrancar el contenedor
# (una sola vez por versión). Siembra producción y, si SEED_DEMO="true", también la demo.
# Destructivo: úsalo solo en el despliegue que lo necesita y quítalo después.
DB_RESET="false"
