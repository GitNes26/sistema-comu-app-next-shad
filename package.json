{
  "name": "sistema-comu-app",
  "version": "0.17.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:https": "next dev --experimental-https -H 0.0.0.0",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 tests/unit/*.test.mjs",
    "test:unit": "node --import tsx --test --test-concurrency=1 tests/unit/*.test.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/db-reset.mjs",
    "gcv": "node scripts/gcv.mjs",
    "version:bump": "node scripts/version-bump.mjs",
    "version:init": "node scripts/version-bump.mjs --init",
    "test:integration": "node --test --test-concurrency=1 tests/permissions.integration.test.mjs",
    "postinstall": "prisma generate && node scripts/copy-pdfjs-worker.mjs",
    "vapid:generate": "node scripts/generate-vapid.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts",
    "vapid:generate": "node scripts/generate-vapid.mjs"
  },
  "dependencies": {
    "@fontsource/dancing-script": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.7",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^14.1.0",
    "html5-qrcode": "^2.3.8",
    "input-otp": "^1.5.0",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.55.0",
    "mammoth": "^1.13.0",
    "next": "^16.4.0",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.13",
    "notistack": "^3.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-easy-crop": "^6.2.4",
    "react-hook-form": "^7.90.0",
    "react-leaflet": "^5.0.0",
    "react-resizable-panels": "^4.14.4",
    "recharts": "^3.10.1",
    "shadcn": "^4.21.4",
    "sharp": "^0.35.5",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "yup": "^1.7.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
